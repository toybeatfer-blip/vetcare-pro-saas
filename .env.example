# ===================================================
# VetCare Pro - Archivo de Variables de Entorno (.env)
# ===================================================

# Puerto de escucha del servidor (por defecto 3000 o asignado por el hosting)
PORT=3000

# Entorno de ejecución: development | production
NODE_ENV=production

# Clave API de Google Gemini (Opcional, para funciones avanzadas de VetCopilot IA)
# Consigue una clave gratuita en: https://aistudio.google.com/
GEMINI_API_KEY=
